# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default

# Application Configuration
MAX_FILE_SIZE=104857600
OBJECT_TTL_DAYS=30
AUTH_DISABLED=false
SHARE_SECRET=change-this-in-production-use-openssl-rand-base64-32

# Deployment Stage
STAGE=dev

# For Integration Tests
API_ENDPOINT=https://xxxxx.execute-api.us-east-1.amazonaws.com
AUTH_TOKEN=your-jwt-token-here
FILES_TABLE=cloud-file-share-aws-files-dev
SHARES_TABLE=cloud-file-share-aws-shares-dev
USER_POOL_ID=us-east-1_xxxxxxxxx
USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
